# ==============================================================================
# obsess Discord Bot Website — Environment Configuration Example
# Copy this file to .env.local to customize your deployment.
# NEVER put your bot token in this file or any frontend code!
# ==============================================================================

# Discord Application Client ID (from Discord Developer Portal)
# Default fallback: 1562050707081662538
VITE_DISCORD_CLIENT_ID=1562050707081662538

# Discord Bot Invitation URL
# If empty, automatically generates standard URL using VITE_DISCORD_CLIENT_ID
VITE_DISCORD_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=1562050707081662538&permissions=8&scope=bot%20applications.commands

# Support Server Invite URL
VITE_SUPPORT_SERVER_URL=https://discord.gg/your-support-server

# Optional: Live Bot Telemetry API Endpoint
# Leave empty if you are deploying the website as a static site without a backend.
# If configured, the frontend will poll this endpoint for status, latency, and shard telemetry.
VITE_BOT_STATUS_API=
